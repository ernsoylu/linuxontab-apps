+#if defined(__wasm__)
+/* Linux on WebAssembly has no fork(): spawn through posix_spawn() using the
+ * macOS code path below. musl lacks POSIX_SPAWN_CLOEXEC_DEFAULT, but libuv
+ * opens every descriptor with O_CLOEXEC, and adddup2(fd, fd) clears
+ * FD_CLOEXEC in the child, which is what addinherit_np does on macOS. */
+# include <spawn.h>
+# include <paths.h>
+# define POSIX_SPAWN_CLOEXEC_DEFAULT 0
+# define posix_spawn_file_actions_addinherit_np(actions, fd)                  \
+  posix_spawn_file_actions_adddup2((actions), (fd), (fd))
+#endif
+
 #if defined(__linux__) || \
     defined(__GNU__)
 # include <grp.h>
